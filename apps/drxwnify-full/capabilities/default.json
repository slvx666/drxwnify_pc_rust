{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Drxwnify Full",
  "windows": ["main", "*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "allow-play-track",
    "allow-play-tracks",
    "allow-play-queue-index",
    "allow-clear-queue",
    "allow-toggle-play-pause",
    "allow-seek",
    "allow-set-volume",
    "allow-set-balance",
    "allow-next-track",
    "allow-previous-track",
    "allow-shuffle",
    "allow-set-repeat-mode",
    "allow-get-playback-state",
    "allow-get-spectrum",
    "allow-get-liked",
    "allow-toggle-like",
    "allow-search",
    "allow-get-lyrics",
    "allow-translate-lyrics",
    "allow-get-history",
    "allow-clear-history",
    "allow-get-playlists",
    "allow-create-playlist",
    "allow-add-to-playlist",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-accounts",
    "allow-save-accounts",
    "allow-get-friends",
    "allow-get-messages",
    "allow-send-message",
    "allow-import-backup",
    "allow-download-track",
    "allow-download-clip",
    "allow-get-downloads",
    "allow-remove-download",
    "allow-minimize-window",
    "allow-maximize-window",
    "allow-close-window"
  ]
}
